# ==============================================================================
# Drishti.ai (FinShield) Environment Configuration
# ==============================================================================

# Gemini AI Authentication (Two options):
# Option A: Gemini Developer API Key (from Google AI Studio https://aistudio.google.com/)
GOOGLE_API_KEY=your_gemini_api_key_here

# Option B: Google Cloud Vertex AI (via gcloud auth or Service Account)
# gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCP_REGION=asia-south1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Gemini Models (Configured via env vars - NEVER hardcoded)
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash

# Google Cloud Document AI (Optional - uses built-in layout engine fallback if not set)
# Format: projects/{project_id}/locations/{region}/processors/{processor_id}
DOCUMENTAI_PROCESSOR_ID=

# Storage & Database
GCS_BUCKET_NAME=finshield-claims-docs
FIRESTORE_DATABASE=(default)
BIGQUERY_DATASET=finshield

# Local Offline Mode & Feature Flags
# When LOCAL_FALLBACK=true, all 6 golden claims, deterministic tools, and layout extraction
# run locally with zero API cost and zero network dependencies.
LOCAL_FALLBACK=true
SYNTHID_ENABLED=false
