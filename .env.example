# ==============================================================================
# Drishti.ai (FinShield) Environment Configuration
# ==============================================================================

# Gemini AI Authentication (Two options):
# Option A: Gemini Developer API Key (from Google AI Studio https://aistudio.google.com/)
GOOGLE_API_KEY=your_gemini_api_key_here

# Option B: Google Cloud Vertex AI (via gcloud auth or Service Account)
# gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCP_PROJECT=your-gcp-project-id
GCP_REGION=asia-south1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Gemini Models (Configured via env vars - NEVER hardcoded)
GEMINI_PRO_MODEL=gemini-3.5-flash
GEMINI_FLASH_MODEL=gemini-3.5-flash

# Google Cloud Document AI
# Format: projects/{project_number}/locations/{location}/processors/{processor_id}
DOCUMENTAI_PROCESSOR_ID=projects/your-project-number/locations/us/processors/your-processor-id
DOCUMENTAI_LOCATION=us

# Storage & Database
GCS_BUCKET_NAME=finshield-claims-docs-your-project-id
FIRESTORE_DATABASE=(default)
BIGQUERY_DATASET=finshield

# Cryptographic Provenance Key (leave empty to load from Secret Manager: finshield-provenance-signing-key)
FINSHIELD_PROVENANCE_KEY=

# Cloud Enforcement & Development Token Flags
REQUIRE_CLOUD_ON_STARTUP=true
ALLOW_DEV_TOKENS=true
SYNTHID_ENABLED=false
INJECTION_CHECK_ENABLED=true
WATERMARK_ENABLED=true
RAG_PATTERNS_ENABLED=true
