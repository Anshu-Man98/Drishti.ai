# Frontend Environment Variables Template
# FinShield / Drishti.ai
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to git.

# Backend API Base URL (FastAPI server)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Google Maps Platform API Key (Required for Spacetime Replay)
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Google Maps Map ID (Required for Advanced Marker & Vector Map styling)
VITE_GOOGLE_MAPS_MAP_ID=YOUR_GOOGLE_MAPS_MAP_ID_HERE
